# ReceiptWise 後端環境變數範本。複製成 .env 後依環境修改。
# 正式環境一定要設定 SECRET_KEY / JWT_SECRET_KEY（亂數長字串）。
SECRET_KEY=please-change-me
JWT_SECRET_KEY=please-change-me

# 資料庫（預設 sqlite:///<backend>/instance/receiptwise.db，可用 DATABASE_URL 換 PostgreSQL）
#DATABASE_URL=postgresql://user:password@localhost/receiptwise

# 財政部統一發票中獎號碼 RSS
#LOTTERY_RSS_URL=https://invoice.etax.nat.gov.tw/invoice.xml

# 獎號最少間隔幾小時重抓（有請求時才檢查）
#LOTTERY_REFRESH_HOURS=6

# 允許的 CORS 來源（逗號分隔；開發走 Vite proxy 時用不到）
#CORS_ORIGINS=http://localhost:5173

# 前端 build 產出資料夾；存在時 Flask 直接提供靜態檔（SPA fallback）
#FRONTEND_DIST=../frontend/dist
